{
  "name": "dsh-workflow-orchestrator",
  "version": "0.2.0",
  "type": "module",
  "description": "DeepSeek Harness L5 plugin: visual workflow definitions, validation and deterministic execution exposed as Cordis tools.",
  "license": "MIT",
  "main": "dist-plugin/index.js",
  "exports": {
    ".": {
      "types": "./dist-plugin/index.d.ts",
      "default": "./dist-plugin/index.js"
    },
    "./client": "./dist-client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist-plugin",
    "dist-client",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-0 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2+": "compatible",
        "0.2.1-rc.2+": "compatible",
        "0.2.2-rc.1+": "compatible",
        "0.2.2-rc.3+": "compatible"
      }
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run build:plugin && npm run build:client && npm run build:web",
    "build:web": "vite build",
    "build:plugin": "vite build --config vite.plugin.config.ts",
    "build:client": "vite build --config vite.client.config.ts",
    "typecheck": "tsc -b && tsc -p tsconfig.plugin.json && tsc -p tsconfig.client.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-tools": "0.0.1-rc.1",
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.0",
    "dagre": "^0.8.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "uuid": "^14.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1",
    "@deepseek-ai/schemastery": "^3.19.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/dagre": "^0.7.54",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.8"
  }
}
